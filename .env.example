# Copie para ".env" (ignorado pelo git) e preencha. Nunca commite o .env.

# --- Obrigatórias -----------------------------------------------------------
# URL base do provedor compatível com a biblioteca openai (ex.: https://api.openai.com/v1)
LLM_BASE_URL=
# Chave do provedor
OPENAI_API_KEY=
# Nome do modelo escolhido em docs/modelos.md (ex.: gpt-4o-mini)
LLM_MODEL=

# --- Opcionais (têm valor padrão no código; descomente para mudar) ----------
# LLM_TEMPERATURE=0            # use "none" para modelos que não aceitam temperature
# MAX_PASSOS=8                 # teto de chamadas ao modelo por pergunta
# MAX_TOKENS=20000             # teto de tokens (entrada + saída) por pergunta
# MAX_CUSTO_USD=0.05           # teto de custo por pergunta (só vale se os preços abaixo existirem)
# PRECO_ENTRADA_USD_POR_MILHAO=
# PRECO_SAIDA_USD_POR_MILHAO=
# LIMITE_DIAS_ALERTA_VALIDADE=30
# ID_LOJA=1
# HYDRA_DB_PATH=dados/hydra_demo.db

# --- Só para "python -m src.comparar" (uma chave por provedor dos candidatos) -
# GROQ_API_KEY=
# MISTRAL_API_KEY=
