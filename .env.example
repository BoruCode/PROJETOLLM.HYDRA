# Copie para ".env" (ignorado pelo git) e preencha. Nunca commite o .env.

# --- Obrigatórias -----------------------------------------------------------
# URL base do provedor compatível com a biblioteca openai (ex.: https://api.groq.com/openai/v1)
LLM_BASE_URL=
# Chave do provedor (Groq: gsk_... disponível em console.groq.com/keys)
OPENAI_API_KEY=
# Nome do modelo escolhido em docs/modelos.md (ex.: openai/gpt-oss-120b)
LLM_MODEL=

# --- Opcionais (têm valor padrão no código; descomente para mudar) ----------
# LLM_TEMPERATURE=0
# MAX_PASSOS=8
# MAX_TOKENS=20000
# MAX_CUSTO_USD=0.05
# LIMITE_DIAS_ALERTA_VALIDADE=30
# ID_LOJA=1
# HYDRA_DB_PATH=dados/hydra_demo.db

# --- Parte 2 (opcionais) ----------------------------------------------------
# MEMORIA=on
# MODO_CONFIRMACAO=sincrono
# PASTA_CHECKPOINTS=checkpoints